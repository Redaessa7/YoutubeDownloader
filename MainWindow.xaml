<Window x:Class="YoutubeDownloader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YouTube Pro Downloader" Height="680" Width="880"
        Background="#080808" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" ResizeMode="CanMinimize">

    <Window.Resources>

        <!-- ── ComboBox Toggle Button (الزرار الشفاف اللي بيفتح القائمة) ── -->
        <Style x:Key="ComboToggleBtn" TargetType="ToggleButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <!-- شفاف تماماً — فقط يستقبل الكليك ويغير IsChecked ↔ IsDropDownOpen -->
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── ComboBox Style ───────────────────────────────── -->
        <Style x:Key="DarkCombo" TargetType="ComboBox">
            <Setter Property="Background"      Value="#181818"/>
            <Setter Property="Foreground"      Value="#F0F0F0"/>
            <Setter Property="BorderBrush"     Value="#2a2a2a"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height"          Value="44"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <!-- الخلفية والإطار -->
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10">
                                <Grid>
                                    <!-- العنصر المختار -->
                                    <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      Margin="14,0,40,0" VerticalAlignment="Center"
                                                      IsHitTestVisible="False"/>
                                    <!-- سهم لأسفل -->
                                    <Path x:Name="Arrow" HorizontalAlignment="Right"
                                          Margin="0,0,14,0" VerticalAlignment="Center"
                                          Data="M0,0 L6,6 L12,0"
                                          Stroke="#555" StrokeThickness="1.5"
                                          Fill="Transparent" IsHitTestVisible="False"/>
                                </Grid>
                            </Border>

                            <!-- ToggleButton شفاف فوق كل شيء — هو اللي بيفتح القائمة عند الضغط -->
                            <ToggleButton Style="{StaticResource ComboToggleBtn}"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen,
                                                      RelativeSource={RelativeSource TemplatedParent},
                                                      Mode=TwoWay}"/>

                            <!-- القائمة المنسدلة -->
                            <Popup x:Name="Popup" Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False"
                                   PopupAnimation="Slide"
                                   StaysOpen="False">
                                <Border Background="#1a1a1a" BorderBrush="#333" BorderThickness="1"
                                        CornerRadius="10" Margin="0,4,0,0"
                                        MinWidth="{TemplateBinding ActualWidth}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="20" Opacity="0.5" ShadowDepth="5"/>
                                    </Border.Effect>
                                    <ScrollViewer MaxHeight="220" Margin="0,4">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#444"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#FF2020"/>
                                <Setter TargetName="Arrow"  Property="Stroke"      Value="#FF2020"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── ComboBoxItem Style ───────────────────────────── -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#ccc"/>
            <Setter Property="Padding"    Value="14,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bg" Background="{TemplateBinding Background}"
                                Margin="4,2" CornerRadius="7">
                            <ContentPresenter Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#252525"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#2a0a0a"/>
                                <Setter Property="Foreground" Value="#FF2020"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── RadioButton Pill Style ───────────────────────── -->
        <Style x:Key="PillRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#666"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="pill" Background="Transparent"
                                BorderBrush="#2a2a2a" BorderThickness="1"
                                CornerRadius="20" Padding="16,6">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="dot" Width="7" Height="7"
                                         Fill="#333" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="pill" Property="Background"  Value="#1a0505"/>
                                <Setter TargetName="pill" Property="BorderBrush" Value="#FF2020"/>
                                <Setter TargetName="dot"  Property="Fill"        Value="#FF2020"/>
                                <Setter Property="Foreground" Value="#F0F0F0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="pill" Property="BorderBrush" Value="#444"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Background="#080808">

        <!-- ambient red glow top-center -->
        <Ellipse Width="600" Height="220" VerticalAlignment="Top"
                 HorizontalAlignment="Center" Margin="0,-90,0,0" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#18FF2020" Offset="0"/>
                    <GradientStop Color="#00000000" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="58"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ══ HEADER ═════════════════════════════════════════════════════ -->
            <Border Grid.Row="0" BorderBrush="#181818" BorderThickness="0,0,0,1">
                <Grid Margin="24,0">
                    <!-- Logo -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#FF2020" CornerRadius="7" Width="32" Height="22" Margin="0,0,10,0">
                            <Path Data="M9.545 15.568V8.432L15.818 12z"
                                  Fill="White" Stretch="Uniform" Margin="4"/>
                        </Border>
                        <TextBlock Text="YouTube" Foreground="White"  FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock Text=" Pro"    Foreground="#FF2020" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Fragment badge -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border Background="#0f1a0f" BorderBrush="#1a2a1a" BorderThickness="1"
                                CornerRadius="20" Padding="10,4">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Fill="#00D26A"
                                         Margin="0,0,7,0" VerticalAlignment="Center"/>
                                <TextBlock Text="8× Parallel Fragments" Foreground="#4a8a4a" FontSize="10"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ══ URL INPUT ══════════════════════════════════════════════════ -->
            <StackPanel Grid.Row="1" Margin="32,26,32,6">
                <Grid HorizontalAlignment="Center" Width="660">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="54"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" CornerRadius="14,0,0,14"
                            Background="#141414" BorderBrush="#222" BorderThickness="1,1,0,1">
                        <Grid>
                            <TextBlock x:Name="TxtPlaceholder"
                                       Text="Paste YouTube URL here…"
                                       Foreground="#2e2e2e" FontSize="13"
                                       Margin="16,0" VerticalAlignment="Center"
                                       IsHitTestVisible="False"/>
                            <TextBox x:Name="TxtUrl"
                                     Background="Transparent" Foreground="#F0F0F0"
                                     BorderThickness="0" Margin="15,0"
                                     VerticalContentAlignment="Center"
                                     FontSize="13" CaretBrush="White" Height="46"
                                     TextChanged="TxtUrl_TextChanged"/>
                        </Grid>
                    </Border>

                    <Button x:Name="BtnAnalyze" Grid.Column="1"
                            Click="BtnAnalyze_Click" Cursor="Hand" ToolTip="Analyze video">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bg" Background="#FF2020" CornerRadius="0,14,14,0">
                                    <TextBlock Text="→" Foreground="White" FontSize="20" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bg" Property="Background" Value="#cc1a1a"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="bg" Property="Background" Value="#1c1c1c"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- Audio pills -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,13,0,0">
                    <TextBlock Text="AUDIO" Foreground="#2e2e2e" FontSize="9" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <RadioButton x:Name="RadioAudioLow"  Content="Smallest File"
                                 Style="{StaticResource PillRadio}"
                                 IsChecked="True" Margin="0,0,8,0"/>
                    <RadioButton x:Name="RadioAudioHigh" Content="Best Audio"
                                 Style="{StaticResource PillRadio}"/>
                </StackPanel>
            </StackPanel>

            <!-- ══ VIDEO CARD ═════════════════════════════════════════════════ -->
            <Border Grid.Row="2" x:Name="VideoCard"
                    Visibility="Collapsed"
                    Margin="32,8,32,8" Background="#111"
                    CornerRadius="18" BorderBrush="#1e1e1e" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" Direction="270" Opacity="0.5" ShadowDepth="6"/>
                </Border.Effect>
                <Grid Margin="20,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="210"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Thumbnail with play icon overlay -->
                    <Border Grid.Column="0" CornerRadius="12" ClipToBounds="True"
                            Background="#0d0d0d" Height="118" VerticalAlignment="Top">
                        <Grid>
                            <Image x:Name="ImgThumbnail" Stretch="UniformToFill"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <Border Background="#44000000">
                                <Border Background="#88000000" Width="32" Height="32"
                                        CornerRadius="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Data="M5,3 L19,11 L5,19 Z" Fill="White"
                                          Stretch="Uniform" Width="10" Height="10" Margin="2,0,0,0"/>
                                </Border>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Video metadata + format picker -->
                    <StackPanel Grid.Column="1" Margin="18,0,0,0">
                        <TextBlock x:Name="TxtTitle" Text="Video Title"
                                   Foreground="#F0F0F0" FontSize="15" FontWeight="SemiBold"
                                   TextWrapping="Wrap" MaxHeight="46" Margin="0,0,0,8" LineHeight="22"/>

                        <!-- Channel row -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Background="#1e1e1e" CornerRadius="5" Padding="6,2" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="5" Height="5" Fill="#FF2020"
                                             Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="YouTube" Foreground="#666" FontSize="9" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                            <TextBlock x:Name="TxtChannel" Text="Channel Name"
                                       Foreground="#777" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Quality header -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="QUALITY" Foreground="#2e2e2e"
                                       FontSize="9" FontWeight="Bold"
                                       Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <Border Background="#0d1a0d" BorderBrush="#1a2a1a"
                                    BorderThickness="1" CornerRadius="4" Padding="6,2">
                                <TextBlock Text="⚡ 8× FRAGMENTS" Foreground="#4a8a4a" FontSize="9" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>

                        <ComboBox x:Name="ComboFormats"
                                  Style="{StaticResource DarkCombo}"
                                  SelectionChanged="ComboFormats_SelectionChanged">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Background="#1a0505" CornerRadius="4" Padding="5,2" Margin="0,0,10,0">
                                            <TextBlock Text="▶" Foreground="#FF2020" FontSize="8" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="{Binding Display}" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock x:Name="TxtFormatInfo"
                                   Text="Select your preferred resolution above"
                                   Foreground="#333" FontSize="10" Margin="4,8,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ══ DOWNLOAD BAR ═══════════════════════════════════════════════ -->
            <StackPanel Grid.Row="3" Margin="32,0,32,20">

                <Button x:Name="BtnDownload" Height="48"
                        Click="BtnDownload_Click"
                        IsEnabled="False" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bg" CornerRadius="24">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#FF2020" Offset="0"/>
                                        <GradientStop Color="#BB1010" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock x:Name="btnIcon" Text="⬇  "
                                               Foreground="White" FontSize="14"/>
                                    <TextBlock x:Name="btnLabel" Text="START DOWNLOAD"
                                               Foreground="White" FontSize="13" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="bg" Property="Background" Value="#181818"/>
                                    <Setter TargetName="btnLabel" Property="Foreground" Value="#2e2e2e"/>
                                    <Setter TargetName="btnIcon"  Property="Foreground" Value="#2e2e2e"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bg" Property="Opacity" Value="0.88"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Status row -->
                <Grid Margin="4,7,4,3">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="#2e2e2e" Margin="0,0,7,0"/>
                        <TextBlock x:Name="TxtStatus" Text="Ready"
                                   Foreground="#555" FontSize="11"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock x:Name="TxtSpeed" Text=""
                                   Foreground="#444" FontSize="11"
                                   FontFamily="Consolas" Margin="0,0,16,0"/>
                        <TextBlock x:Name="TxtEta" Text=""
                                   Foreground="#444" FontSize="11" FontFamily="Consolas"/>
                    </StackPanel>
                </Grid>

                <!-- Progress bar -->
                <Border Height="4" CornerRadius="2" Background="#181818">
                    <ProgressBar x:Name="ProgBar" Height="4"
                                 Minimum="0" Maximum="100"
                                 BorderThickness="0" Background="Transparent">
                        <ProgressBar.Template>
                            <ControlTemplate TargetType="ProgressBar">
                                <Grid>
                                    <Border Background="Transparent" CornerRadius="2"/>
                                    <Border x:Name="PART_Track" Background="Transparent" CornerRadius="2"/>
                                    <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="2">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#FF2020" Offset="0"/>
                                                <GradientStop Color="#FF5555" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="5" Color="#FF2020" Opacity="0.7" ShadowDepth="0"/>
                                        </Border.Effect>
                                    </Border>
                                </Grid>
                            </ControlTemplate>
                        </ProgressBar.Template>
                    </ProgressBar>
                </Border>

                <TextBlock x:Name="TxtPercent" Text=""
                           Foreground="#333" HorizontalAlignment="Right"
                           Margin="0,3,2,0" FontSize="10" FontFamily="Consolas"/>
            </StackPanel>
        </Grid>

        <!-- ══ SUCCESS OVERLAY ═══════════════════════════════════════════════ -->
        <Grid x:Name="SuccessOverlay" Visibility="Collapsed" Background="#BB000000">
            <Border Background="#111" CornerRadius="20"
                    Width="320" Height="210"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    BorderBrush="#1e1e1e" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" Opacity="0.8" ShadowDepth="0"/>
                </Border.Effect>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border Background="#0c1f0c" Width="54" Height="54"
                            CornerRadius="27" HorizontalAlignment="Center" Margin="0,0,0,12">
                        <TextBlock Text="✓" Foreground="#00D26A" FontSize="28" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Download Complete!" Foreground="White"
                               FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="File saved successfully"
                               Foreground="#444" FontSize="11"
                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    <Button Content="  Done  " Click="CloseSuccess_Click"
                            Height="34" Margin="0,18,0,0" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bg" Background="#FF2020" CornerRadius="17" Padding="20,0">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bg" Property="Background" Value="#cc1a1a"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.Foreground>
                            <SolidColorBrush Color="White"/>
                        </Button.Foreground>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</Window>
