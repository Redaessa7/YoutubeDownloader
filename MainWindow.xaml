<Window x:Class="YoutubeDownloader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YouTube Pro Downloader" Height="650" Width="850" 
        Background="#0f0f0f" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Semibold">

    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#0f0f0f" BorderBrush="#222" BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                    <Path Data="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z" Fill="#FF0000" Stretch="Uniform" Height="22" Margin="0,0,10,0"/>
                    <TextBlock Text="YouTube Pro" Foreground="White" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="1" Margin="20,25,20,10">
                <Grid Width="600" HorizontalAlignment="Center">
                    <Grid.ColumnDefinitions> <ColumnDefinition Width="*"/> <ColumnDefinition Width="70"/> </Grid.ColumnDefinitions>
                    <Border CornerRadius="22,0,0,22" Background="#121212" BorderBrush="#333" BorderThickness="1">
                        <TextBox x:Name="TxtUrl" Background="Transparent" Foreground="White" BorderThickness="0" Margin="15,0" VerticalContentAlignment="Center" FontSize="14" CaretBrush="White" Height="40"/>
                    </Border>
                    <Button x:Name="BtnAnalyze" Grid.Column="1" Click="BtnAnalyze_Click" Background="#222" BorderBrush="#333" BorderThickness="0,1,1,1">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="0,22,22,0">
                                    <TextBlock Text="🔍" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
                    <RadioButton x:Name="RadioLow" Content="Smallest File" IsChecked="True" Foreground="#aaa" Margin="0,0,25,0"/>
                    <RadioButton x:Name="RadioHigh" Content="Best Audio" Foreground="#aaa"/>
                </StackPanel>
            </StackPanel>


<Border Grid.Row="2" x:Name="VideoCard" Visibility="Collapsed" Margin="40,20" Background="#1A1A1A" CornerRadius="20" BorderBrush="#333" BorderThickness="1">
    <Border.Effect>
        <DropShadowEffect BlurRadius="15" Direction="270" Opacity="0.3" ShadowDepth="5"/>
    </Border.Effect>
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/> <ColumnDefinition Width="*"/>   </Grid.ColumnDefinitions>

        <Border Grid.Column="0" CornerRadius="12" ClipToBounds="True" Background="#121212" Height="135" VerticalAlignment="Top">
            <Image x:Name="ImgThumbnail" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
        </Border>

        <StackPanel Grid.Column="1" Margin="25,0,0,0">
            <TextBlock x:Name="TxtTitle" Text="Video Title" Foreground="White" FontSize="18" FontWeight="Bold" TextWrapping="Wrap" MaxHeight="55" Margin="0,0,0,5"/>
            
            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                <Border Background="#FF0000" CornerRadius="4" Padding="4,1" Margin="0,0,8,0">
                    <TextBlock Text="LIVE" Foreground="White" FontSize="9" FontWeight="Black"/>
                </Border>
                <TextBlock x:Name="TxtChannel" Text="Channel Name" Foreground="#AAAAAA" FontSize="14"/>
            </StackPanel>

            <TextBlock Text="Quality Settings" Foreground="#555" FontSize="11" FontWeight="Bold" Margin="2,0,0,5" TextAlignment="Left"/>
            <ComboBox x:Name="ComboFormats" Height="42" Background="#252525" Foreground="White" BorderThickness="1" BorderBrush="#444">
                <ComboBox.Resources>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Padding" Value="10"/>
                    </Style>
                </ComboBox.Resources>
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⬤" Foreground="#FF0000" FontSize="8" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding Display}" Foreground="Black" FontWeight="Medium"/>
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <TextBlock x:Name="TxtVideoInfo" Text="Select your preferred resolution above" Foreground="#666" FontSize="11" Margin="5,10,0,0"/>
        </StackPanel>
    </Grid>
</Border>

            <StackPanel Grid.Row="3" Margin="40,0,40,25">
                <Button x:Name="BtnDownload" Content="START DOWNLOAD" Click="BtnDownload_Click" Height="50" Background="White" Foreground="Black" FontWeight="Bold" IsEnabled="False">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="25">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="border" Property="Background" Value="#333"/>
                                    <Setter Property="Foreground" Value="#666"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Grid Margin="0,5">
                    <TextBlock x:Name="TxtStatus" Text="Ready" Foreground="#aaa" FontSize="11"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock x:Name="TxtSpeed" Text="0 MiB/s" Foreground="#888" FontSize="11" Margin="0,0,15,0"/>
                        <TextBlock x:Name="TxtEta" Text="ETA: --:--" Foreground="#888" FontSize="11"/>
                    </StackPanel>
                </Grid>
                <ProgressBar x:Name="ProgBar" Height="4" Foreground="#FF0000" Background="#333" BorderThickness="0"/>
                <TextBlock x:Name="TxtPercent" Text="0%" Foreground="White" HorizontalAlignment="Center" Margin="0,5,0,0" FontSize="11"/>
            </StackPanel>
        </Grid>

        <Grid x:Name="SuccessOverlay" Visibility="Collapsed" Background="#CC000000">
            <Border Background="#1e1e1e" CornerRadius="15" Width="300" Height="180" VerticalAlignment="Center" HorizontalAlignment="Center" BorderBrush="#333" BorderThickness="1">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="✔" Foreground="#00FF00" FontSize="40" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock Text="Download Completed!" Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <Button Content="OK" Click="CloseSuccess_Click" Width="80" Height="30" Margin="0,20,0,0" Background="#FF0000" Foreground="White" BorderThickness="0">
                        <Button.Resources> <Style TargetType="Border"><Setter Property="CornerRadius" Value="15"/></Style> </Button.Resources>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>