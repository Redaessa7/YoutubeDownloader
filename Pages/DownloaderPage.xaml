<Page x:Class="YoutubeDownloader.Pages.DownloaderPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent"
      FontFamily="Segoe UI">

    <Page.Resources>

        <!-- ComboBox toggle -->
        <Style x:Key="ComboToggleBtn" TargetType="ToggleButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark ComboBox -->
        <Style x:Key="DarkCombo" TargetType="ComboBox">
            <Setter Property="Background"      Value="#0e0e0e"/>
            <Setter Property="Foreground"      Value="#d0d0d0"/>
            <Setter Property="BorderBrush"     Value="#282828"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height"          Value="42"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8">
                                <Grid>
                                    <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      Margin="12,0,36,0" VerticalAlignment="Center"
                                                      IsHitTestVisible="False"/>
                                    <Path x:Name="Arrow" HorizontalAlignment="Right"
                                          Margin="0,0,12,0" VerticalAlignment="Center"
                                          Data="M0,0 L5,5 L10,0"
                                          Stroke="#444" StrokeThickness="1.5"
                                          Fill="Transparent" IsHitTestVisible="False"/>
                                </Grid>
                            </Border>
                            <ToggleButton Style="{StaticResource ComboToggleBtn}" Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"/>
                            <Popup x:Name="Popup" Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False"
                                   PopupAnimation="Slide" StaysOpen="False">
                                <Border Background="#111" BorderBrush="#2a2a2a" BorderThickness="1"
                                        CornerRadius="8" Margin="0,3,0,0"
                                        MinWidth="{TemplateBinding ActualWidth}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="24" Opacity="0.6" ShadowDepth="4"/>
                                    </Border.Effect>
                                    <ScrollViewer MaxHeight="200" Margin="0,4">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#3a3a3a"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#FF2020"/>
                                <Setter TargetName="Arrow"  Property="Stroke"      Value="#FF2020"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBoxItem -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#aaa"/>
            <Setter Property="Padding"    Value="12,9"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bg" Background="{TemplateBinding Background}"
                                Margin="4,1" CornerRadius="6">
                            <ContentPresenter Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#1e1e1e"/>
                                <Setter Property="Foreground" Value="#eee"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#1f0808"/>
                                <Setter Property="Foreground" Value="#FF4040"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pill RadioButton -->
        <Style x:Key="PillRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#555"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="pill" Background="Transparent"
                                BorderBrush="#222" BorderThickness="1"
                                CornerRadius="6" Padding="14,7">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="dot" Width="6" Height="6"
                                         Fill="#2a2a2a" Margin="0,0,8,0"
                                         VerticalAlignment="Center"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="pill" Property="Background"  Value="#180505"/>
                                <Setter TargetName="pill" Property="BorderBrush" Value="#FF2020"/>
                                <Setter TargetName="dot"  Property="Fill"        Value="#FF2020"/>
                                <Setter Property="Foreground" Value="#eee"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="pill" Property="BorderBrush" Value="#3a3a3a"/>
                                <Setter Property="Foreground" Value="#999"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ══ MAIN CONTENT ══ -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32,28,32,16">

                <!-- Page title -->
                <StackPanel Margin="0,0,0,28">
                    <TextBlock Text="Download anything." Foreground="#e0e0e0"
                                       FontSize="24" FontWeight="Bold"/>
                    <TextBlock Text="Paste a YouTube link — video or playlist."
                               Foreground="#444" FontSize="13" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- ── URL Input Card ── -->
                <Border Background="#0d0d0d" BorderBrush="#1e1e1e" BorderThickness="1"
                        CornerRadius="14" Padding="20,18" Margin="0,0,0,16">
                    <StackPanel>

                        <TextBlock Text="VIDEO / PLAYLIST URL" Foreground="#333"
                                   FontSize="9" FontWeight="Bold" Margin="0,0,0,10"/>

                        <!-- URL input row -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#080808"
                                    BorderBrush="#252525" BorderThickness="1"
                                    CornerRadius="10" Height="48">
                                <Grid>
                                    <TextBlock x:Name="TxtPlaceholder"
                                               Text="https://youtube.com/watch?v=…"
                                               Foreground="#252525" FontSize="13"
                                               FontFamily="Consolas"
                                               Margin="16,0" VerticalAlignment="Center"
                                               IsHitTestVisible="False"/>
                                    <TextBox x:Name="TxtUrl"
                                             Background="Transparent" Foreground="#d0d0d0"
                                             BorderThickness="0" Margin="14,0"
                                             VerticalContentAlignment="Center"
                                             FontSize="13" FontFamily="Consolas"
                                             CaretBrush="#FF2020"
                                             TextChanged="TxtUrl_TextChanged"/>
                                </Grid>
                            </Border>

                            <Button x:Name="BtnAnalyze" Grid.Column="2"
                                    Click="BtnAnalyze_Click" Cursor="Hand"
                                    Width="112" Height="48">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bg" CornerRadius="10">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#FF2020" Offset="0"/>
                                                    <GradientStop Color="#CC1010" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <StackPanel Orientation="Horizontal"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="Analyze" Foreground="White"
                                                           FontSize="13" FontWeight="SemiBold"
                                                           Margin="0,0,6,0"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bg" Property="Opacity" Value="0.85"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="bg" Property="Background" Value="#161616"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <!-- Audio quality -->
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <TextBlock Text="AUDIO" Foreground="#2a2a2a"
                                       FontSize="9" FontWeight="Bold"
                                       VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <RadioButton x:Name="RadioAudioLow" Content="Smallest file"
                                         Style="{StaticResource PillRadio}"
                                         IsChecked="True" Margin="0,0,8,0"/>
                            <RadioButton x:Name="RadioAudioHigh" Content="Best audio"
                                         Style="{StaticResource PillRadio}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ── Video Result Card ── -->
                <Border x:Name="VideoCard" Visibility="Collapsed"
                        Background="#0d0d0d" BorderBrush="#1e1e1e" BorderThickness="1"
                        CornerRadius="14" Margin="0,0,0,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Thumbnail strip -->
                        <Border Grid.Row="0" CornerRadius="14,14,0,0"
                                ClipToBounds="True" Height="160">
                            <Grid>
                                <Image x:Name="ImgThumbnail" Stretch="UniformToFill"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       Opacity="0.7"/>
                                <!-- dark overlay gradient -->
                                <Border>
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#00000000" Offset="0"/>
                                            <GradientStop Color="#CC000000" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <!-- Play icon -->
                                <Border Width="44" Height="44" CornerRadius="22"
                                        Background="#88000000"
                                        HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                        Margin="20,0,0,16">
                                    <Path Data="M5,3 L19,11 L5,19 Z" Fill="White"
                                          Stretch="Uniform" Width="12" Height="12"
                                          Margin="3,0,0,0"/>
                                </Border>
                                <!-- Title overlay -->
                                <StackPanel VerticalAlignment="Bottom"
                                            Margin="76,0,16,16">
                                    <TextBlock x:Name="TxtTitle" Text="Video Title"
                                               Foreground="White" FontSize="14"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap" MaxHeight="40"
                                               LineHeight="20"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <Border Background="#33FF2020" CornerRadius="4"
                                                Padding="6,2" Margin="0,0,8,0">
                                            <TextBlock Text="YouTube" Foreground="#FF6060"
                                                       FontSize="9" FontWeight="Bold"/>
                                        </Border>
                                        <TextBlock x:Name="TxtChannel"
                                                   Foreground="#aaa" FontSize="11"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Quality selector -->
                        <StackPanel Grid.Row="1" Margin="20,16,20,20">
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="SELECT QUALITY" Foreground="#333"
                                           FontSize="9" FontWeight="Bold"
                                           VerticalAlignment="Center"/>
                                <Border HorizontalAlignment="Right"
                                        Background="#0d1a0d" BorderBrush="#1a2a1a"
                                        BorderThickness="1" CornerRadius="5" Padding="7,3">
                                    <TextBlock Text="⚡ 8× PARALLEL" Foreground="#4a8a4a"
                                               FontSize="9" FontWeight="Bold"/>
                                </Border>
                            </Grid>

                            <ComboBox x:Name="ComboFormats" Style="{StaticResource DarkCombo}"
                                      SelectionChanged="ComboFormats_SelectionChanged">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Background="#1a0505" CornerRadius="4"
                                                    Padding="5,2" Margin="0,0,10,0">
                                                <TextBlock Text="▶" Foreground="#FF4040"
                                                           FontSize="8" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="{Binding Display}"
                                                       FontSize="12" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <TextBlock x:Name="TxtFormatInfo"
                                       Text="Select your preferred resolution above"
                                       Foreground="#2a2a2a" FontSize="10"
                                       FontFamily="Consolas" Margin="2,8,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ── Playlist Card ── -->
                <Border x:Name="PlaylistCard" Visibility="Collapsed"
                        Background="#0d0d0d" BorderBrush="#1e1e1e" BorderThickness="1"
                        CornerRadius="14" Padding="20,18" Margin="0,0,0,16">
                    <StackPanel>

                        <!-- Header -->
                        <Grid Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#1a0505" CornerRadius="10"
                                        Width="40" Height="40" Margin="0,0,14,0">
                                    <TextBlock Text="≡" Foreground="#FF2020"
                                               FontSize="18" FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtPlaylistTitle" Text="Playlist"
                                               Foreground="#e0e0e0" FontSize="14"
                                               FontWeight="SemiBold"/>
                                    <TextBlock x:Name="TxtPlaylistChannel"
                                               Foreground="#444" FontSize="11"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>
                            <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Background="#180505" BorderBrush="#2a0a0a"
                                    BorderThickness="1" CornerRadius="8" Padding="10,5">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="TxtVideoCount" Text="0"
                                               Foreground="#FF2020" FontSize="16"
                                               FontWeight="Bold" VerticalAlignment="Center"/>
                                    <TextBlock Text=" videos" Foreground="#555"
                                               FontSize="11" VerticalAlignment="Center"
                                               Margin="0,1,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Height="1" Background="#181818" Margin="0,0,0,16"/>

                        <!-- Quality + Range row -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="QUALITY" Foreground="#2a2a2a"
                                           FontSize="9" FontWeight="Bold" Margin="0,0,0,6"/>
                                <ComboBox x:Name="ComboPlaylistQuality"
                                          Style="{StaticResource DarkCombo}">
                                    <ComboBoxItem Content="Best Quality" IsSelected="True"/>
                                    <ComboBoxItem Content="1080p"/>
                                    <ComboBoxItem Content="720p"/>
                                    <ComboBoxItem Content="480p"/>
                                    <ComboBoxItem Content="360p"/>
                                    <ComboBoxItem Content="Worst Quality"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="RANGE (optional)" Foreground="#2a2a2a"
                                           FontSize="9" FontWeight="Bold" Margin="0,0,0,6"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#080808"
                                            BorderBrush="#252525" BorderThickness="1"
                                            CornerRadius="8" Height="42">
                                        <TextBox x:Name="TxtPlaylistFrom" Text=""
                                                 Background="Transparent" Foreground="#d0d0d0"
                                                 BorderThickness="0" Margin="10,0"
                                                 VerticalContentAlignment="Center"
                                                 FontSize="13" CaretBrush="#FF2020"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="–" Foreground="#333"
                                               FontSize="14" VerticalAlignment="Center"
                                               Margin="8,0"/>
                                    <Border Grid.Column="2" Background="#080808"
                                            BorderBrush="#252525" BorderThickness="1"
                                            CornerRadius="8" Height="42">
                                        <TextBox x:Name="TxtPlaylistTo" Text=""
                                                 Background="Transparent" Foreground="#d0d0d0"
                                                 BorderThickness="0" Margin="10,0"
                                                 VerticalContentAlignment="Center"
                                                 FontSize="13" CaretBrush="#FF2020"/>
                                    </Border>
                                </Grid>
                                <TextBlock Text="leave blank for all videos"
                                           Foreground="#252525" FontSize="9"
                                           Margin="2,5,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- Save folder -->
                        <TextBlock Text="SAVE FOLDER" Foreground="#2a2a2a"
                                   FontSize="9" FontWeight="Bold" Margin="0,0,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#080808"
                                    BorderBrush="#252525" BorderThickness="1,1,0,1"
                                    CornerRadius="8,0,0,8" Height="42">
                                <TextBlock x:Name="TxtPlaylistFolder"
                                           Text="No folder selected…"
                                           Foreground="#333" FontSize="12"
                                           FontFamily="Consolas"
                                           Margin="12,0" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                            </Border>
                            <Button Grid.Column="1" x:Name="BtnChooseFolder"
                                    Click="BtnChooseFolder_Click" Cursor="Hand" Height="42">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bg" Background="#1a1a1a"
                                                BorderBrush="#252525" BorderThickness="1"
                                                CornerRadius="0,8,8,0" Padding="14,0">
                                            <TextBlock Text="Browse" Foreground="#888"
                                                       FontSize="12" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bg" Property="Background" Value="#222"/>
                                                <Setter TargetName="bg" Property="BorderBrush" Value="#333"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <!-- Playlist progress -->
                        <Border x:Name="PlaylistProgressPanel" Visibility="Collapsed"
                                Background="#080808" BorderBrush="#1a1a1a"
                                BorderThickness="1" CornerRadius="10"
                                Margin="0,16,0,0" Padding="16,14">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock x:Name="TxtCurrentVideoLabel"
                                               Text="Preparing…"
                                               Foreground="#888" FontSize="11"/>
                                    <TextBlock x:Name="TxtPlaylistOverall"
                                               HorizontalAlignment="Right"
                                               Foreground="#333" FontSize="11"
                                               FontFamily="Consolas"/>
                                </Grid>
                                <TextBlock x:Name="TxtCurrentVideoTitle" Text=""
                                           Foreground="#555" FontSize="10"
                                           FontFamily="Consolas"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,0,0,10"/>

                                <!-- Video bar -->
                                <TextBlock Text="CURRENT" Foreground="#222"
                                           FontSize="8" FontWeight="Bold" Margin="0,0,0,4"/>
                                <Border Height="3" CornerRadius="2" Background="#141414" Margin="0,0,0,10">
                                    <ProgressBar x:Name="ProgBarVideo" Height="3"
                                                 Minimum="0" Maximum="100"
                                                 BorderThickness="0" Background="Transparent">
                                        <ProgressBar.Template>
                                            <ControlTemplate TargetType="ProgressBar">
                                                <Grid>
                                                    <Border x:Name="PART_Track" Background="Transparent" CornerRadius="2"/>
                                                    <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="2">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                <GradientStop Color="#FF6600" Offset="0"/>
                                                                <GradientStop Color="#FFAA00" Offset="1"/>
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                    </Border>
                                                </Grid>
                                            </ControlTemplate>
                                        </ProgressBar.Template>
                                    </ProgressBar>
                                </Border>

                                <!-- Overall bar -->
                                <TextBlock Text="OVERALL" Foreground="#222"
                                           FontSize="8" FontWeight="Bold" Margin="0,0,0,4"/>
                                <Border Height="4" CornerRadius="2" Background="#141414">
                                    <ProgressBar x:Name="ProgBarPlaylist" Height="4"
                                                 Minimum="0" Maximum="100"
                                                 BorderThickness="0" Background="Transparent">
                                        <ProgressBar.Template>
                                            <ControlTemplate TargetType="ProgressBar">
                                                <Grid>
                                                    <Border x:Name="PART_Track" Background="Transparent" CornerRadius="2"/>
                                                    <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="2">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                <GradientStop Color="#FF2020" Offset="0"/>
                                                                <GradientStop Color="#FF5040" Offset="1"/>
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                        <Border.Effect>
                                                            <DropShadowEffect BlurRadius="6" Color="#FF2020"
                                                                              Opacity="0.6" ShadowDepth="0"/>
                                                        </Border.Effect>
                                                    </Border>
                                                </Grid>
                                            </ControlTemplate>
                                        </ProgressBar.Template>
                                    </ProgressBar>
                                </Border>

                            </StackPanel>
                        </Border>

                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ══ BOTTOM BAR ══ -->
        <Border Grid.Row="1" Background="#080808"
                BorderBrush="#161616" BorderThickness="0,1,0,0"
                Padding="32,16,32,20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="4"/>
                </Grid.RowDefinitions>

                <!-- Download button -->
                <Button x:Name="BtnDownload" Grid.Row="0" Height="46"
                        Click="BtnDownload_Click" IsEnabled="False" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bg" CornerRadius="10">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#FF2020" Offset="0"/>
                                        <GradientStop Color="#BB1010" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <TextBlock x:Name="BtnIcon" Text="  "
                                               Foreground="White" FontSize="16"
                                               FontWeight="Bold"/>
                                    <TextBlock x:Name="BtnLabel" Text="START DOWNLOAD"
                                               Foreground="White" FontSize="12"
                                               FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="bg"       Property="Background" Value="#111"/>
                                    <Setter TargetName="BtnLabel" Property="Foreground" Value="#252525"/>
                                    <Setter TargetName="BtnIcon"  Property="Foreground" Value="#252525"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bg" Property="Opacity" Value="0.86"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Status row -->
                <Grid Grid.Row="2">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="StatusDot" Width="5" Height="5"
                                 Fill="#252525" Margin="0,0,7,0"/>
                        <TextBlock x:Name="TxtStatus" Text="Ready"
                                   Foreground="#333" FontSize="10"
                                   FontFamily="Consolas"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock x:Name="TxtSpeed" Text=""
                                   Foreground="#333" FontSize="10"
                                   FontFamily="Consolas" Margin="0,0,14,0"/>
                        <TextBlock x:Name="TxtEta" Text=""
                                   Foreground="#333" FontSize="10"
                                   FontFamily="Consolas"/>
                        <TextBlock x:Name="TxtPercent" Text=""
                                   Foreground="#FF2020" FontSize="10"
                                   FontFamily="Consolas" FontWeight="Bold"
                                   Margin="14,0,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- Progress bar -->
                <Border Grid.Row="4" CornerRadius="2" Background="#141414">
                    <ProgressBar x:Name="ProgBar" Height="4"
                                 Minimum="0" Maximum="100"
                                 BorderThickness="0" Background="Transparent">
                        <ProgressBar.Template>
                            <ControlTemplate TargetType="ProgressBar">
                                <Grid>
                                    <Border x:Name="PART_Track" Background="Transparent" CornerRadius="2"/>
                                    <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="2">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#FF2020" Offset="0"/>
                                                <GradientStop Color="#FF5040" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="6" Color="#FF2020"
                                                              Opacity="0.7" ShadowDepth="0"/>
                                        </Border.Effect>
                                    </Border>
                                </Grid>
                            </ControlTemplate>
                        </ProgressBar.Template>
                    </ProgressBar>
                </Border>

            </Grid>
        </Border>

        <!-- ── Success Overlay ── -->
        <Grid x:Name="SuccessOverlay" Grid.RowSpan="2"
              Visibility="Collapsed" Background="#CC000000">
            <Border Background="#0f0f0f" CornerRadius="16"
                    Width="300" Height="220"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    BorderBrush="#1e1e1e" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" Opacity="0.9" ShadowDepth="0"/>
                </Border.Effect>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border Background="#0a1e0a" Width="50" Height="50"
                            CornerRadius="25" HorizontalAlignment="Center"
                            Margin="0,0,0,14">
                        <TextBlock Text="✓" Foreground="#00D26A" FontSize="24"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="TxtSuccessTitle" Text="Done!"
                               Foreground="White" FontSize="18" FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtSuccessSubtitle" Text="File saved successfully"
                               Foreground="#444" FontSize="11"
                               HorizontalAlignment="Center"
                               Margin="0,6,0,0" TextAlignment="Center"/>
                    <Button Content="Close" Click="CloseSuccess_Click"
                            Height="36" Width="100" Margin="0,20,0,0" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bg" Background="#1a1a1a"
                                        BorderBrush="#2a2a2a" BorderThickness="1"
                                        CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bg" Property="Background" Value="#222"/>
                                        <Setter TargetName="bg" Property="BorderBrush" Value="#FF2020"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.Foreground>
                            <SolidColorBrush Color="#888"/>
                        </Button.Foreground>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</Page>
