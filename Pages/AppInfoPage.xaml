<Page x:Class="OcTubeDownloader.Pages.AppInfoPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      d:DesignHeight="650" d:DesignWidth="850"
      Title="App Info" Background="#0A0A0A">

    <Grid>
        <Border>
            <Border.Background>
                <RadialGradientBrush Center="0.5,-0.2" GradientOrigin="0.5,-0.2" RadiusX="1" RadiusY="1">
                    <GradientStop Color="#1AEE0000" Offset="0"/>
                    <GradientStop Color="#00000000" Offset="1"/>
                </RadialGradientBrush>
            </Border.Background>
        </Border>

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="450">
            
            <Border Width="100" Height="100" CornerRadius="25" Background="#151515" Margin="0,0,0,20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" Color="Black" Opacity="0.3"/>
                </Border.Effect>
                <Image Source="pack://application:,,,/Assets/logo.png" Margin="15"/>
            </Border>

            <TextBlock Text="OcTube Downloader" 
                       Foreground="White" 
                       FontSize="32" 
                       FontWeight="ExtraBold" 
                       HorizontalAlignment="Center"/>

            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <TextBlock Text="v " Foreground="White" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtVersion" Text="2.1.1" Foreground="White" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
            <Border Background="#CCFF0000" CornerRadius="8" Padding="12,3" HorizontalAlignment="Center" Margin="0,10,0,24">
                <TextBlock x:Name="TxtVersionLabel" Text="STABLE RELEASE" Foreground="White" FontSize="10" FontWeight="Black"/>
            </Border>

            <!-- Download engine status -->
            <Border Background="#151515" BorderBrush="#222" BorderThickness="1"
                    CornerRadius="12" Padding="16,14" Margin="0,0,0,0">
                <StackPanel>
                    <TextBlock Text="DOWNLOAD ENGINE" Foreground="#555" FontSize="9" FontWeight="Bold" Margin="0,0,0,8"/>
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="yt-dlp " Foreground="#888" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtYtDlpVersion" Text="checking…" Foreground="White"
                                       FontSize="12" FontFamily="Consolas" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button x:Name="BtnUpdateYtDlp" Content="Update engine"
                                Click="BtnUpdateYtDlp_Click" Cursor="Hand"
                                HorizontalAlignment="Right" Padding="14,6"
                                Background="#1f0808" Foreground="#FF6060"
                                BorderBrush="#3a1010" BorderThickness="1"/>
                    </Grid>
                    <TextBlock x:Name="TxtYtDlpStatus" Text="YouTube changes often — keep the engine updated."
                               Foreground="#444" FontSize="10" Margin="0,8,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,30,0,0" Opacity="0.4">
                <TextBlock Text="Made with ❤️ by" Foreground="White" VerticalAlignment="Center"/>
                 <TextBlock x:Name="TxtCopyright" Text="Redaessa" Foreground="White" Margin="5,0" VerticalAlignment="Center"/>
            </StackPanel>

        </StackPanel>
    </Grid>
</Page>