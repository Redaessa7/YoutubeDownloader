<Page x:Class="YoutubeDownloader.Pages.AppInfoPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="800"
      Title="AppInfoPage" Background="#0F0F0F"> <Grid Margin="30">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="500">
            
            <Border Width="80" Height="80" Background="#FF0000" CornerRadius="20" Margin="0,0,0,20">
                <Path Data="M32.5,28.5V41.5L43.5,35L32.5,28.5Z" Fill="White" Stretch="Uniform" Margin="25"/>
            </Border>

            <TextBlock Text="YouTube Downloader" 
                       Foreground="White" 
                       FontSize="28" 
                       FontWeight="Bold" 
                       HorizontalAlignment="Center" 
                       Margin="0,0,0,5"/>

            <Border Background="#272727" CornerRadius="12" Padding="12,4" HorizontalAlignment="Center" Margin="0,0,0,30">
                <TextBlock x:Name="TxtVersionLabel" Text="STABLE RELEASE" Foreground="#AAAAAA" FontSize="12" FontWeight="SemiBold"/>
            </Border>

            <Border Background="#1F1F1F" CornerRadius="15" Padding="20">
                <StackPanel>
                    <Grid Margin="0,10">
                        <TextBlock Text="الإصدار" Foreground="#AAAAAA" FontSize="14" HorizontalAlignment="Right"/>
                        <TextBlock x:Name="TxtVersion" Text="2.0.1" Foreground="White" FontSize="14" FontWeight="Medium" HorizontalAlignment="Left"/>
                    </Grid>
                    
                    <Separator Background="#333333" Margin="0,5"/>

                    <Grid Margin="0,10">
                        <TextBlock Text="المطور" Foreground="#AAAAAA" FontSize="14" HorizontalAlignment="Right"/>
                        <TextBlock x:Name="TxtDeveloperName" Text="Ahmed Elsayed" Foreground="White" FontSize="14" FontWeight="Medium" HorizontalAlignment="Left"/>
                    </Grid>

                    <Separator Background="#333333" Margin="0,5"/>

                    <Grid Margin="0,10">
                        <TextBlock Text="الدعم الفني" Foreground="#AAAAAA" FontSize="14" HorizontalAlignment="Right"/>
                        <TextBlock x:Name="TxtDeveloperEmail" Text="contact@domain.com" Foreground="#3EA6FF" FontSize="14" FontWeight="Medium" HorizontalAlignment="Left" Cursor="Hand"/>
                    </Grid>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,40,0,0" Opacity="0.5">
                <TextBlock Text="© " Foreground="White"/>
                <TextBlock x:Name="TxtCopyright" Text="Ahmed Elsayed" Foreground="White" Margin="5,0"/>
                <TextBlock Text="2024" Foreground="White"/>
            </StackPanel>

        </StackPanel>
    </Grid>
</Page>